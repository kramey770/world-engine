{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "src",
    "ignoreDeprecations": "5.0",
    "checkJs": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "es2021",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "src/node_modules"],
  "exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
