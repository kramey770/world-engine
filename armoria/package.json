{
  "name": "armoria",
  "description": "Heraldry generator and editor",
  "version": "1.1.0",
  "packageManager": "pnpm@11.24.0",
  "author": "Azgaar <azgaar.fmg@yandex.com>",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "dev": "rollup -c -w",
    "start": "sirv public",
    "build": "rollup -c",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit --pretty false",
    "deploy": "gh-pages -d public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azgaar/Armoria.git"
  },
  "keywords": [
    "heraldry",
    "svelte",
    "procedural-generation"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Azgaar/Armoria/issues"
  },
  "main": "./src/main.js",
  "dependencies": {
    "path-data-polyfill": "^1.0.10"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^3.0.0",
    "@rollup/plugin-typescript": "^8.3.0",
    "esbuild": "^0.28.2",
    "rollup-plugin-css-only": "^4.5.5",
    "gh-pages": "^6.3.0",
    "rollup": "^2.3.4",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup-plugin-workbox": "^9.0.0",
    "sirv-cli": "^1.0.0",
    "svelte": "5.57.0",
    "svelte-check": "4.3.1",
    "svelte-i18n": "4.0.1",
    "svelte-preprocess": "6.0.5",
    "tslib": "^2.3.1",
    "typescript": "5.9.3"
  }
}
